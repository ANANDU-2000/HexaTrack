# HEXATRACK BACKEND ENV TEMPLATE
# Set real values in Render or local private env only. Do not commit real secrets.

ConnectionStrings__Postgres=postgresql://<user>:<password>@<host>/<database>
ConnectionStrings__PostgresInternal=postgresql://<user>:<password>@<internal-host>/<database>
ConnectionStrings__Redis=redis://<user>:<password>@<host>:<port>

Jwt__Issuer=https://hexatrack.onrender.com
Jwt__Audience=hexatrack-frontend
Jwt__SigningKey=<generate-secure-256-bit-secret>
Jwt__ExpiryMinutes=15
Jwt__RefreshExpiryDays=30

Google__ClientId=<google-client-id>
Google__ClientSecret=<google-client-secret>

Cors__AllowedOrigins__0=https://hexatrack.vercel.app
Cors__AllowedOrigins__1=http://localhost:3000

Razorpay__KeyId=<razorpay-key-id>
Razorpay__KeySecret=<razorpay-key-secret>
Razorpay__WebhookSecret=<razorpay-webhook-secret>

Stripe__SecretKey=<stripe-secret-key>
Stripe__WebhookSecret=<stripe-webhook-secret>
Stripe__PriceId__Basic=<stripe-price-basic>
Stripe__PriceId__Pro=<stripe-price-pro>
Stripe__PriceId__ProMax=<stripe-price-pro-max>

Anthropic__ApiKey=<anthropic-api-key>
Anthropic__Model=claude-sonnet-4-20250514
Anthropic__MaxTokens=1000

Storage__Provider=r2
Storage__AccessKey=<storage-access-key>
Storage__SecretKey=<storage-secret-key>
Storage__BucketName=hexatrack-uploads
Storage__AccountId=<storage-account-id>
Storage__PublicUrl=<storage-public-url>
